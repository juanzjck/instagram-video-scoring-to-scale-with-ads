# Copy to .env and fill in. NEVER commit .env
# Any value left blank falls back to old/FirstTest-prompts/.env, then to the default.
# Keep comments on their own line: `KEY=   # note` is read as the value "# note".
ANTHROPIC_API_KEY=
# only if your key is not scoped to a workspace
ANTHROPIC_WORKSPACE_ID=
# anthropic (default) | openai | gemini | ollama | openai_compatible. The UI can override per session.
LLM_PROVIDER=
# model for LLM_PROVIDER. Anthropic default: claude-opus-5-5
LLM_MODEL=
# optional per-provider defaults
ANTHROPIC_MODEL=
OPENAI_MODEL=
GEMINI_MODEL=
OLLAMA_MODEL=
LOCAL_LLM_MODEL=
# Gemini (pip install google-genai). GOOGLE_API_KEY also works.
GEMINI_API_KEY=
# local models. defaults: http://localhost:11434 and 16384 tokens of context
OLLAMA_BASE_URL=
OLLAMA_NUM_CTX=
# OpenAI-compatible local server. default: http://localhost:1234/v1 (LM Studio)
LOCAL_LLM_BASE_URL=
LOCAL_LLM_API_KEY=
# tiny | base | small | medium
WHISPER_MODEL=base

# --- OpenAI: the pipeline LLM when LLM_PROVIDER=openai, and generated media (optional).
# Claude makes no audio or images, so these use OpenAI.
# Without a key: recap voice = macOS `say`, example clips = drawn slides.
OPENAI_API_KEY=
# auto (openai when a key is set, else say) | openai | say
TTS_PROVIDER=
# default: gpt-4o-mini-tts
OPENAI_TTS_MODEL=
# default: marin
OPENAI_TTS_VOICE=
# default: gpt-image-2
OPENAI_IMAGE_MODEL=
# low | medium | high. default: medium
OPENAI_IMAGE_QUALITY=
