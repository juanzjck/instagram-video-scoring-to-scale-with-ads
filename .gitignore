# --- from full-workflow-api ---
!.env.example
# pipeline artifacts (frames, audio, model outputs). decisions.jsonl is the human log.
runs/*/
# uploaded datasets, with their own runs/
uploads/

# background server log + pid
logs/

# env backups (contain real keys)
*.env.bak
