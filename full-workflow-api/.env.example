# Copy to .env and fill in. NEVER commit .env
# Any value left blank falls back to ../FirstTest-prompts/.env, then to the default.
# Keep comments on their own line: `KEY=   # note` is read as the value "# note".
ANTHROPIC_API_KEY=
# only if your key is not scoped to a workspace
ANTHROPIC_WORKSPACE_ID=
# default: claude-opus-5-5
LLM_MODEL=
# tiny | base | small | medium
WHISPER_MODEL=base

# --- generated media (optional). Claude makes no audio or images, so these use OpenAI.
# Without a key: recap voice = macOS `say`, example clips = drawn slides.
OPENAI_API_KEY=
# auto (openai when a key is set, else say) | openai | say
TTS_PROVIDER=
# default: gpt-4o-mini-tts
OPENAI_TTS_MODEL=
# default: marin
OPENAI_TTS_VOICE=
# default: gpt-image-2
OPENAI_IMAGE_MODEL=
# low | medium | high. default: medium
OPENAI_IMAGE_QUALITY=
