# Copy to .env and fill in. NEVER commit .env
LLM_PROVIDER=anthropic          # openai | anthropic
LLM_MODEL=                      # e.g. claude-sonnet-4-5 (anthropic) or gpt-4.1-mini (openai)

# Only the key for the provider you selected is required
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Only needed if your API key is not scoped to a workspace
ANTHROPIC_WORKSPACE_ID=
