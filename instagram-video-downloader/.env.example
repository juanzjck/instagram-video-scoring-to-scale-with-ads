# --- Login for yt-dlp (recommended: Instagram blocks most anonymous requests) ---
# Browser where you are logged into instagram.com: chrome, safari, firefox, edge, brave
IG_COOKIES_BROWSER=chrome
# or a Netscape cookies.txt export
IG_COOKIES_FILE=

# Seconds between posts (raise it if you get "rate-limit" / "login required")
IG_DELAY_S=5

# --- Optional: Instagram Graph API (Business/Creator account linked to a Facebook Page) ---
# Unlocks reach, shares, saved, avg watch time, ALL comments for posts this account owns,
# follower countries for this account, and follower counts of other Business/Creator accounts.
IG_ACCESS_TOKEN=
IG_USER_ID=
IG_GRAPH_VERSION=v23.0
